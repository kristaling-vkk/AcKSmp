 #                   auto-migrate up via the bundled updater on next start.
 config-flavor: V2
 config-version: 14
+
+# Server-side guards (Paper/Folia; ported from LegacyGrim, tightening patches only)
+# Block ender pearl throws at point blank into a solid wall/ceiling (pearl phasing)
+PearlPhasePrevention: true
+# Push players that end up inside a full solid block up to 3 blocks up on the same X/Z
+PushOutOfBlocks: true
+# Accepted block placements per player per server tick, both hands together; 0 disables the limit
+BlockPlaceLimit: 2
+# End crystal placements per second per player, both hands together; 0 disables the limit
+CrystalPlaceLimit: 6
+# Separate (lower) crystal limit for the first second after changing the held item; 0 = use CrystalPlaceLimit
+CrystalSwapPlaceLimit: 0
+# Allow placing a crystal on the same tick the main hand slot changed (silent swap)
+AllowCrystalSilentSwap: false
